# ---- LLM (GROQ free tier) ----
GROQ_API_KEY=

# ---- News search (pick one, both have free tiers) ----
SERPER_API_KEY=
NEWSAPI_API_KEY=

# ---- Slack (Incoming Webhook, private channel) ----
SLACK_WEBHOOK_URL=

# ---- Google Sheets (service account) ----
# Paste the FULL contents of the service account JSON key as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# ---- Pipeline config ----
NEWS_TOPICS=AI,finance,space,biotech
MAX_PER_TOPIC=1

# ---- Dashboard cron auth ----
# Used by api/run-pipeline.py to authorize the GitHub Actions 6-hour cron
# (RUN_SECRET) and Vercel's own daily cron fallback (CRON_SECRET). The
# dashboard's manual "Run Pipeline Now" button doesn't need either — it's
# cooldown-protected instead.
RUN_SECRET=
CRON_SECRET=

RUN_COOLDOWN_SECONDS=20